<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_light"
    tools:context=".BandMyGigsActivity">

    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/TextAppearance.TugtogPH.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Gigs"
            android:textSize="22sp" />

        <TextView
            style="@style/TextAppearance.TugtogPH.MutedCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Track your applications and confirmed bookings" />

        <!-- Applied / Booked / Saved segmented toggle -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TugtogPH.Card.Subtle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabApplied"
                    style="@style/Widget.TugtogPH.Button.Band"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="Applied" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabBooked"
                    style="@style/Widget.TugtogPH.Button.Band"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="Booked" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabSaved"
                    style="@style/Widget.TugtogPH.Button.Band"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="Saved" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyBandGigs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        tools:listitem="@layout/item_band_gig" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topSection">

        <TextView
            android:id="@+id/tvEmptyTitle"
            style="@style/TextAppearance.TugtogPH.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="No applications yet" />

        <TextView
            android:id="@+id/tvEmptyBody"
            style="@style/TextAppearance.TugtogPH.MutedCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            tools:text="Gigs you apply to will show up here." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowseGigs"
            style="@style/Widget.TugtogPH.Button.Band"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="20dp"
            android:text="Find Gigs" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_band_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
