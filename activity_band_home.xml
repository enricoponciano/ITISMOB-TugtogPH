<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_light"
    tools:context=".BandHomeActivity">

    <!-- Header: greeting, search and genre filters -->
    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/TextAppearance.TugtogPH.MutedCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tugtog_emerald_dark"
                    android:textStyle="bold"
                    tools:text="HI, HIRAYA COLLECTIVE" />

                <TextView
                    style="@style/TextAppearance.TugtogPH.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find Gigs"
                    android:textSize="22sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tugtog_emerald"
                app:strokeWidth="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Open band profile"
                    android:scaleType="centerCrop"
                    android:src="@drawable/band1" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Search -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_filled"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/text_muted"
            android:hint="Search gigs, venues or cities"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <!-- Genre filter chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@+id/chipAll"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIndie"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indie"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAcoustic"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acoustic"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRock"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rock"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipJazz"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jazz"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOpenJam"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Jam"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvResultCount"
            style="@style/TextAppearance.TugtogPH.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            tools:text="6 OPEN GIGS" />
    </LinearLayout>

    <!-- Gig list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBandGigs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        tools:listitem="@layout/item_band_gig" />

    <!-- Empty state (no search results) -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topSection">

        <TextView
            style="@style/TextAppearance.TugtogPH.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No gigs match your search" />

        <TextView
            style="@style/TextAppearance.TugtogPH.MutedCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Try another genre or clear the search." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearFilters"
            style="@style/Widget.TugtogPH.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="Clear Filters" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_band_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
