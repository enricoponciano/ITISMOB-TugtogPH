<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. BASE APPLICATION THEME (Strictly Light Mode) -->
    <style name="Base.Theme.TugtogPH" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tugtog_emerald</item>
        <item name="colorPrimaryVariant">@color/tugtog_emerald_dark</item>
        <item name="colorSecondary">@color/tugtog_amber</item>
        <item name="android:windowBackground">@color/bg_screen_light</item>
        <item name="android:statusBarColor">@color/bg_card_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.TugtogPH" parent="Base.Theme.TugtogPH" />

    <!-- 2. REUSABLE TYPOGRAPHY CLASSES -->
    <style name="TextAppearance.TugtogPH.Heading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_light</item>
    </style>

    <style name="TextAppearance.TugtogPH.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_light</item>
    </style>

    <style name="TextAppearance.TugtogPH.FieldLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_muted_light</item>
    </style>

    <style name="TextAppearance.TugtogPH.MutedCaption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted_light</item>
    </style>

    <!-- 3. REUSABLE CARD CONTAINERS -->
    <style name="Widget.TugtogPH.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="cardBackgroundColor">@color/bg_card_light</item>
    </style>

    <style name="Widget.TugtogPH.Card.Subtle" parent="Widget.TugtogPH.Card">
        <item name="cardBackgroundColor">@color/bg_subtle_light</item>
    </style>

    <!-- 4. REUSABLE FORM INPUTS -->
    <style name="Widget.TugtogPH.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/tugtog_emerald</item>
        <item name="boxBackgroundColor">@color/bg_card_light</item>
        <item name="hintTextColor">@color/tugtog_emerald</item>
    </style>

    <!-- 5. REUSABLE BUTTONS (BAND EMERALD / ORGANIZER AMBER / SECONDARY OUTLINE) -->
    <style name="Widget.TugtogPH.Button.Band" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tugtog_emerald</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.TugtogPH.Button.Organizer" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tugtog_amber</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.TugtogPH.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/bg_subtle_light</item>
    </style>

    <!-- 6. GENRE / FILTER PILL CHIPS -->
    <style name="Widget.TugtogPH.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">16dp</item>
        <item name="chipBackgroundColor">@color/bg_subtle_light</item>
        <item name="chipStrokeColor">@color/border_light</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textSize">11sp</item>
    </style>

</resources>