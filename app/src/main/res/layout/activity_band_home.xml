<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_light"
    tools:context=".BandHomeActivity">

    <!-- Header: greeting, search and genre filters -->
    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/TextAppearance.TugtogPH.MutedCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tugtog_emerald_dark"
                    android:textStyle="bold"
                    tools:text="HI, HIRAYA COLLECTIVE" />

                <TextView
                    style="@style/TextAppearance.TugtogPH.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find Gigs"
                    android:textSize="22sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tugtog_emerald"
                app:strokeWidth="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Open band profile"
                    android:scaleType="centerCrop"
                    android:src="@drawable/band1" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Search and Location Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_filled"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_muted"
                android:hint="Search gigs, venues..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <!-- Location & Radius Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/bg_subtle_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/layoutLocationHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_pin"
                            app:tint="@color/tugtog_emerald" />

                        <TextView
                            android:id="@+id/tvSelectedCity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Quezon City"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivLocationToggle"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/outline_arrow_drop_down_24"
                            app:tint="@color/text_primary" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvRadiusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="#DCFCE7"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Within 20 km"
                            android:textColor="@color/tugtog_emerald_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="5.0"
                        android:valueTo="50.0"
                        android:value="20.0"
                        android:stepSize="5.0"
                        android:visibility="gone"
                        app:thumbColor="@color/tugtog_emerald"
                        app:trackColorActive="@color/tugtog_emerald"
                        app:trackColorInactive="@color/border_light"
                        app:tickVisible="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Map Preview -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#E2E8F0"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Water/Land styling: just text labels for now to fake a map -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAKATI"
                        android:textColor="#CBD5E1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QC"
                        android:textColor="#CBD5E1"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginEnd="30dp"
                        android:layout_marginTop="20dp" />

                        <!-- Radius Overlay -->
                    <View
                        android:id="@+id/mapRadiusOverlay"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_map_radius"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintVertical_bias="0.4"
                        app:layout_constraintHorizontal_bias="0.6"/>

                    <!-- Pins -->
                    <!-- Mow's Bar (Active) -->
                    <TextView
                        android:id="@+id/pinMows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/tugtog_emerald"
                        android:text="Mow's Bar"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        app:drawableStartCompat="@drawable/ic_music"
                        app:drawableTint="@color/white"
                        android:drawablePadding="4dp"
                        app:layout_constraintTop_toTopOf="@id/mapRadiusOverlay"
                        app:layout_constraintStart_toStartOf="@id/mapRadiusOverlay"
                        app:layout_constraintEnd_toEndOf="@id/mapRadiusOverlay"
                        app:layout_constraintVertical_bias="0.3" />

                    <!-- SaGuijo Cafe + Bar -->
                    <TextView
                        android:id="@+id/pinSaguijo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/white"
                        android:text="SaGuijo"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        app:drawableStartCompat="@drawable/ic_music"
                        app:drawableTint="@color/text_primary"
                        android:drawablePadding="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="50dp" />

                    <!-- Hive Stage Taytay -->
                    <TextView
                        android:id="@+id/pinHive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/white"
                        android:text="Hive Stage"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        app:drawableStartCompat="@drawable/ic_music"
                        app:drawableTint="@color/text_primary"
                        android:drawablePadding="4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="50dp"
                        android:layout_marginEnd="10dp" />

                    <!-- 19 East (Faded) -->
                    <TextView
                        android:id="@+id/pin19East"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/white"
                        android:text="19 East"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:alpha="0.5"
                        app:drawableStartCompat="@drawable/ic_music"
                        app:drawableTint="@color/text_primary"
                        android:drawablePadding="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginBottom="10dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Genre filter chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@+id/chipAll"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOpmIndie"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPM Indie"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAltRock"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alt Rock"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPopPunk"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pop Punk"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNearest"
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearest"
                    android:textColor="@color/chip_band_text"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_band_bg"
                    app:chipStrokeColor="@color/chip_band_stroke" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvResultCount"
            style="@style/TextAppearance.TugtogPH.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            tools:text="6 OPEN GIGS" />
    </LinearLayout>

    <!-- Gig list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBandGigs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        tools:listitem="@layout/item_band_gig" />

    <!-- Empty state (no search results) -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topSection">

        <TextView
            style="@style/TextAppearance.TugtogPH.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No gigs match your search" />

        <TextView
            style="@style/TextAppearance.TugtogPH.MutedCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Try another genre or clear the search." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearFilters"
            style="@style/Widget.TugtogPH.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="Clear Filters" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_band_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
