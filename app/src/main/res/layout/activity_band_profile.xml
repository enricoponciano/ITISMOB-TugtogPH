<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_light">

    <!-- Scrollable profile content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero header — mirrors venue profile structure -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/ivBandProfileCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/band1"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#99000000"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Emerald "VERIFIED BAND" pill -->
                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:text="VERIFIED BAND"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:chipBackgroundColor="@color/tugtog_emerald"
                        app:chipCornerRadius="4dp"
                        app:chipMinHeight="24dp"
                        app:chipStrokeWidth="0dp" />

                    <TextView
                        android:id="@+id/tvBandName"
                        style="@style/TextAppearance.TugtogPH.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hiraya Collective"
                        android:textColor="@color/white"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvBandLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="6dp"
                        android:text="Quezon City • 48.3k listeners"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_music"
                        app:drawableTint="@color/tugtog_emerald" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Profile content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Edit Profile (read-only — no nav for now) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditBandProfile"
                    style="@style/Widget.TugtogPH.Button.Band"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:text="Edit Profile" />

                <!-- Log Out -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBandLogout"
                    style="@style/Widget.TugtogPH.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    android:text="Log Out"
                    android:textColor="@color/tugtog_emerald"
                    app:strokeColor="@color/tugtog_emerald" />

                <!-- Genre chips -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TugtogPH.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.TugtogPH.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="Genres" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGenre1"
                                style="@style/Widget.TugtogPH.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OPM Indie"
                                android:textColor="@color/tugtog_emerald"
                                app:chipBackgroundColor="@color/tugtog_emerald_tint"
                                app:chipStrokeColor="@color/tugtog_emerald_soft" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGenre2"
                                style="@style/Widget.TugtogPH.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Alt Rock"
                                android:textColor="@color/tugtog_emerald"
                                app:chipBackgroundColor="@color/tugtog_emerald_tint"
                                app:chipStrokeColor="@color/tugtog_emerald_soft" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGenre3"
                                style="@style/Widget.TugtogPH.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Math Rock"
                                android:textColor="@color/tugtog_emerald"
                                app:chipBackgroundColor="@color/tugtog_emerald_tint"
                                app:chipStrokeColor="@color/tugtog_emerald_soft" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Spotify top tracks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SPOTIFY TOP TRACKS"
                        android:textColor="@color/tugtog_emerald" />
                    <TextView
                        style="@style/TextAppearance.TugtogPH.MutedCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to preview" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TugtogPH.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Track 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="@color/bg_screen_dark"
                                app:cardCornerRadius="4dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_music"
                                    app:tint="@color/white" />
                            </com.google.android.material.card.MaterialCardView>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/TextAppearance.TugtogPH.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Katipunan 2AM"
                                    android:textSize="13sp" />
                                <TextView
                                    style="@style/TextAppearance.TugtogPH.MutedCaption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="LRT Line 2 EP • 412K plays" />
                            </LinearLayout>
                            <TextView
                                style="@style/TextAppearance.TugtogPH.MutedCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3:48" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_light" />

                        <!-- Track 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="@color/bg_screen_dark"
                                app:cardCornerRadius="4dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_music"
                                    app:tint="@color/white" />
                            </com.google.android.material.card.MaterialCardView>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/TextAppearance.TugtogPH.CardTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ulan sa Maginhawa"
                                    android:textSize="13sp" />
                                <TextView
                                    style="@style/TextAppearance.TugtogPH.MutedCaption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="LRT Line 2 EP • 289K plays" />
                            </LinearLayout>
                            <TextView
                                style="@style/TextAppearance.TugtogPH.MutedCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4:12" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- About the Band -->
                <TextView
                    style="@style/TextAppearance.TugtogPH.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="About the Band" />

                <TextView
                    android:id="@+id/tvBandBio"
                    style="@style/TextAppearance.TugtogPH.MutedCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="5-piece alternative/math-rock band from QC."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="13sp" />

                <!-- Tech rider -->
                <TextView
                    style="@style/TextAppearance.TugtogPH.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Tech Rider" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TugtogPH.Card.Subtle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            style="@style/TextAppearance.TugtogPH.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Gear Needs:"
                            android:textColor="@color/tugtog_emerald" />
                        <TextView
                            android:id="@+id/tvTechRiderGear"
                            style="@style/TextAppearance.TugtogPH.MutedCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2x Guitar Amps, 1x Bass Rig, 5-pc Drum Kit (own breakables), 3x Vocal Mics."
                            android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation — Me tab active -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/bg_card_light"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_music"
                app:tint="@color/text_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Discover"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navApplied"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_group"
                app:tint="@color/text_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Applied"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_map_pin"
                app:tint="@color/tugtog_emerald" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Me"
                android:textColor="@color/tugtog_emerald"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
