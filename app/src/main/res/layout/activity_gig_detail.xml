<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_light"
    tools:context=".GigDetailActivity">

    <!-- Back button row pinned to top -->
    <LinearLayout
        android:id="@+id/topNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="← Discover"
            android:textColor="@color/tugtog_emerald"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            style="@style/TextAppearance.TugtogPH.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gig Detail" />
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topNavBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/ivGigDetailCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/auth_background"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Dark gradient for text legibility -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:background="#99000000"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Hero text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Venue name as amber chip -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipVenueName"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:chipBackgroundColor="@color/tugtog_amber"
                        app:chipCornerRadius="4dp"
                        app:chipMinHeight="24dp"
                        app:chipStrokeWidth="0dp"
                        tools:text="MOW'S BAR QC" />

                    <TextView
                        android:id="@+id/tvGigDetailTitle"
                        style="@style/TextAppearance.TugtogPH.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        tools:text="Indie &amp; Math Rock Night" />

                    <TextView
                        android:id="@+id/tvGigDetailAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="6dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_map_pin"
                        app:drawableTint="@color/tugtog_emerald"
                        tools:text="Matalino St., Quezon City" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Gig info + actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Info card: date / pay / slots -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TugtogPH.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/TextAppearance.TugtogPH.FieldLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="DATE" />
                            <TextView
                                android:id="@+id/tvGigDetailDate"
                                style="@style/TextAppearance.TugtogPH.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tugtog_amber"
                                tools:text="SAT, NOV 7" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_light"
                            android:layout_marginBottom="10dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/TextAppearance.TugtogPH.FieldLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="PAY" />
                            <TextView
                                android:id="@+id/tvGigDetailPay"
                                style="@style/TextAppearance.TugtogPH.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tugtog_emerald"
                                tools:text="₱3,500" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_light"
                            android:layout_marginBottom="10dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/TextAppearance.TugtogPH.FieldLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SLOTS" />
                            <TextView
                                android:id="@+id/tvGigDetailSlots"
                                style="@style/TextAppearance.TugtogPH.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="3 / 5 booked" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.TugtogPH.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.TugtogPH.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="About this Gig" />

                        <TextView
                            android:id="@+id/tvGigDetailDescription"
                            style="@style/TextAppearance.TugtogPH.MutedCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="13sp"
                            tools:text="Looking for high energy bands. Bring own breakables." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Apply CTA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyGig"
                    style="@style/Widget.TugtogPH.Button.Band"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Apply to this Gig" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
