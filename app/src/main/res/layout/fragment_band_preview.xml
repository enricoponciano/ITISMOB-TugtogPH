<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tugtog_emerald"
                android:text="← Back to Applicants"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                style="@style/TextAppearance.TugtogPH.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Band Preview" />
        </LinearLayout>

        <!-- Cover & Avatar Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivBandCover"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="@color/bg_subtle_light"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/ivBandCover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivBandCover">

                <ImageView
                    android:id="@+id/ivBandAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/bg_card_light" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/ivBandCover"
                app:layout_constraintStart_toEndOf="@id/cardAvatar"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/TextAppearance.TugtogPH.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hiraya Collective" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.TugtogPH.MutedCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quezon City • 48.3k listeners" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Genre Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPM Indie"
                    app:chipBackgroundColor="@color/tugtog_emerald_tint"
                    android:textColor="@color/tugtog_emerald"
                    app:chipStrokeColor="@color/tugtog_emerald_soft"/>

                <com.google.android.material.chip.Chip
                    style="@style/Widget.TugtogPH.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Alt Rock"
                    app:chipBackgroundColor="@color/tugtog_emerald_tint"
                    android:textColor="@color/tugtog_emerald"
                    app:chipStrokeColor="@color/tugtog_emerald_soft"/>
            </LinearLayout>

            <!-- Spotify Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/TextAppearance.TugtogPH.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tugtog_emerald"
                    android:text="SPOTIFY TOP TRACKS" />

                <TextView
                    style="@style/TextAppearance.TugtogPH.MutedCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to preview" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TugtogPH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Track 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/bg_screen_dark"
                            app:cardCornerRadius="4dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_music"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                style="@style/TextAppearance.TugtogPH.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:text="Katipunan 2AM" />
                            <TextView
                                style="@style/TextAppearance.TugtogPH.MutedCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LRT Line 2 EP • 412K plays" />
                        </LinearLayout>
                        <TextView
                            style="@style/TextAppearance.TugtogPH.MutedCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3:48" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

                    <!-- Track 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/bg_screen_dark"
                            app:cardCornerRadius="4dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_music"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                style="@style/TextAppearance.TugtogPH.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:text="Ulan sa Maginhawa" />
                            <TextView
                                style="@style/TextAppearance.TugtogPH.MutedCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LRT Line 2 EP • 289K plays" />
                        </LinearLayout>
                        <TextView
                            style="@style/TextAppearance.TugtogPH.MutedCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4:12" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About & Tech Rider -->
            <TextView
                style="@style/TextAppearance.TugtogPH.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="About &amp; Tech Rider" />

            <TextView
                style="@style/TextAppearance.TugtogPH.MutedCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/text_secondary_light"
                android:text="5-piece alternative/math-rock band from QC." />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TugtogPH.Card.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/tugtog_emerald"
                        android:text="Gear Needs:" />

                    <TextView
                        style="@style/TextAppearance.TugtogPH.MutedCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary_light"
                        android:text="2x Guitar Amps, 1x Bass Rig, 5-pc Drum Kit (own breakables), 3x Vocal Mics." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>