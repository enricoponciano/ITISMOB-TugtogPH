<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_light"
    tools:context=".EditBandActivity">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_arrow_back"
            app:drawableTint="@color/text_secondary" />

        <TextView
            style="@style/TextAppearance.TugtogPH.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Edit Band Profile"
            android:textSize="16sp" />

        <Space
            android:layout_width="64dp"
            android:layout_height="36dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/saveBar"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TugtogPH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Band / Artist Name" />

                    <EditText
                        android:id="@+id/etBandName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_input_filled"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="12dp"
                        android:text="Hiraya Collective"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Home City" />

                    <EditText
                        android:id="@+id/etBandCity"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_input_filled"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:text="Quezon City"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Genres (separate with commas)" />

                    <EditText
                        android:id="@+id/etBandGenres"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_input_filled"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:text="OPM Indie, Alt Rock"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="About the Band" />

                    <EditText
                        android:id="@+id/etBandBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:gravity="top"
                        android:paddingVertical="10dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_input_filled"
                        android:inputType="textMultiLine"
                        android:paddingHorizontal="12dp"
                        android:text="5-piece alternative/math-rock band from QC."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Gear Needs / Tech Rider" />

                    <EditText
                        android:id="@+id/etBandGear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:gravity="top"
                        android:paddingVertical="10dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_input_filled"
                        android:inputType="textMultiLine"
                        android:paddingHorizontal="12dp"
                        android:text="2x Guitar Amps, 1x Bass Rig, 5-pc Drum Kit (own breakables), 3x Vocal Mics."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Facebook Page" />

                    <EditText
                        android:id="@+id/etBandFb"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_input_filled"
                        android:inputType="textUri"
                        android:paddingHorizontal="12dp"
                        android:text="fb.com/hirayacollective"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.TugtogPH.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Contact Number" />

                    <EditText
                        android:id="@+id/etBandPhone"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_filled"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:text="0917-555-0142"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/saveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_light"
        android:elevation="8dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBandProfile"
            style="@style/Widget.TugtogPH.Button.Band"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Band Profile" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
